vars:
  - pages: "1-300"

stages:
  download:
    cmd: python3 src/SEC_filings.py
    deps:
      - src/SEC_filings.py
    outs:
      - data/raw

  parse:
    cmd: python3 src/extract_pdf_text.py
    deps:
      - src/extract_pdf_text.py
      - data/raw
    outs:
      - data/parsed/Apple_10K_2023
      - data/parsed/Apple_10K_2024
      - data/parsed/ocr_summary.json

  tables:
    foreach:
      - { pdf: data/raw/Apple_10K_2023.pdf, name: Apple_10K_2023 }
      - { pdf: data/raw/Apple_10K_2024.pdf, name: Apple_10K_2024 }
    do:
      cmd: >
        python3 src/hybrid_tables.py
        --pdf ${item.pdf}
        --pages ${pages}
        --out data/parsed/tables/Hybrid/${item.name}
      deps:
        - src/hybrid_tables.py
        - ${item.pdf}
      outs:
        - data/parsed/tables/Hybrid/${item.name}

  layout:
    foreach:
      - { pdf: data/raw/Apple_10K_2023.pdf, name: Apple_10K_2023 }
      - { pdf: data/raw/Apple_10K_2024.pdf, name: Apple_10K_2024 }
    do:
      cmd: >
        python3 src/layout_detection.py
        --pdf ${item.pdf}
        --parsed-dir data/parsed/${item.name}
        --out data/parsed/layout/${item.name}
      deps:
        - src/layout_detection.py
        - ${item.pdf}
        - data/parsed/${item.name}
      outs:
        - data/parsed/layout/${item.name}

  docling:
    foreach:
      - { pdf: data/raw/Apple_10K_2023.pdf, name: Apple_10K_2023 }
      - { pdf: data/raw/Apple_10K_2024.pdf, name: Apple_10K_2024 }
    do:
      cmd: >
        python3 src/docling_basic.py
        --pdf ${item.pdf}
        --output data/parsed/docling/${item.name}
      deps:
        - src/docling_basic.py
        - ${item.pdf}
      outs:
        - data/parsed/docling/${item.name}

  export:
    foreach:
      - { name: Apple_10K_2023 }
      - { name: Apple_10K_2024 }
    do:
      cmd: >
        python3 src/provenance_tagging.py
        --pdf data/raw/${item.name}.pdf
        --tables-dir data/parsed/tables/Hybrid/${item.name}
        --layout-dir data/parsed/layout/${item.name}
        --docling-dir data/parsed/docling/${item.name}
        --out data/parsed/provenance/${item.name}
      deps:
        - src/provenance_tagging.py
        - data/raw/${item.name}.pdf
        - data/parsed/tables/Hybrid/${item.name}
        - data/parsed/layout/${item.name}
        - data/parsed/docling/${item.name}
      outs:
        - data/parsed/provenance/${item.name}
